# UBT 的 -Mode=GenerateClangDatabase 以 clang-cl（CL 驱动）生成 compile_commands.json：
#   - 命令形如  clang-cl.exe @"...\Xxx.cpp.obj.rsp"
#   - clangd 会依据可执行名 clang-cl 自动切换 --driver-mode=cl，无需手动指定
#   - 参数（/std:c++20、/TP、-I、MSVC/WindowsSDK 系统头路径）都已写进 .rsp，无需再 Add
# 因此这里只做必要的删减。
CompileFlags:
  Remove:
    # 构建时用 -Werror 把警告升级为错误；编辑器里应保留为警告，否则满屏红。
    - "-Werror"
    - "/WX*"
